# ── Server ───────────────────────────────────────────────────────────
PORT=5000                        # Port the API listens on (default 5000)
NODE_ENV=development             # development | production | test

# ── CORS ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173   # Comma-separated list of allowed origins

# ── LLM Service (optional — local fallback used if omitted) ───────────
GROQ_KEY=                         # Groq API key (starts with gsk_)
OPENROUTER_KEY=                   # OpenRouter API key (starts with sk-or-)
# LLM_API_KEYS=                   # Optional comma-separated extra keys (e.g. sk-or-...)
# LLM_PRIORITY=groq,openrouter    # Fallback priority order (default "groq,openrouter")
# LLM_MODEL_GROQ=qwen/qwen3.8-27b
# LLM_MODEL_OPENROUTER=baidu/ernie-5.5-flash-preview:free
# LLM_BASE_URL=                   # Custom base URL for OpenAI-compatible providers

# ── Redis (optional for now) ─────────────────────────────────────────
REDIS_URL=                       # Redis connection string (caching / queues)
