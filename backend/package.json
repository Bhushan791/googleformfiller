{
  "name": "formbot-backend",
  "version": "1.0.0",
  "description": "Backend API for Form Auto Filler — generates and submits test responses to Google Forms.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test src/formParser.test.js src/responseGenerator.test.js src/submission.test.js src/llm.test.js src/prewarm.test.js src/production.test.js",
    "inspect-form": "node src/scripts/inspectForm.js",
    "test-llm": "node src/scripts/testLLM.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "google-forms",
    "auto-filler",
    "testing"
  ],
  "license": "MIT",
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
