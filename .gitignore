# ==============================================================================
# Autofillr - Global .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
redisimplementation.md
# Environment variables and secrets (NEVER commit credentials or keys)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!*/.env.example

# Production builds & caches
dist/
dist-ssr/
build/
out/
*/dist/
*/build/
.vite/
*/.vite/
.turbo/
.parcel-cache/
*.tsbuildinfo

# Logs & debugging
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage & reports
coverage/
.nyc_output/
*.lcov

# Temporary files & runtime artifacts
.cache/
*/.cache/
.temp/
tmp/
temp/
.eslintcache
.stylelintcache
*.tmp
job-*-results.csv

# IDE and Editor configurations
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
